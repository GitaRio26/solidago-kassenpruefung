{
  "name": "solidago-kassenpruefung",
  "productName": "SOLIDAGO Kassenpruefung",
  "version": "0.1.2",
  "description": "Kassenprüfung für SOLIDAGO-Gemeinschaften: Anträge und Rechnungen vom Handy fotografieren, lokal auslesen, prüfen und Bericht erstellen.",
  "main": "src/main/main.js",
  "author": "SOLIDAGO Kassenprüfung",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node test/pruefung.test.js && node test/auslesen.test.js --tjs && node test/durchlauf.test.js --tjs",
    "test:cli": "node test/pruefung.test.js && node test/auslesen.test.js",
    "dist": "electron-builder --win --x64 --publish never"
  },
  "dependencies": {
    "pdfjs-dist": "3.11.174",
    "qrcode": "^1.5.4",
    "tesseract.js": "^6.0.1"
  },
  "devDependencies": {
    "electron": "^36.4.0",
    "electron-builder": "^25.1.8",
    "sharp": "^0.33.5"
  },
  "build": {
    "appId": "de.solidago.kassenpruefung",
    "productName": "SOLIDAGO Kassenpruefung",
    "asar": false,
    "directories": { "output": "dist" },
    "files": [
      "src/**/*",
      "package.json",
      "!test/**",
      "!node_modules/pdfjs-dist/{legacy,types,web,image_decoders}/**",
      "!node_modules/pdfjs-dist/build/*.mjs",
      "!node_modules/pdfjs-dist/build/*.map"
    ],
    "extraResources": [
      { "from": "resources/tessdata", "to": "tessdata" }
    ],
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "icon": "resources/icon.png",
      "artifactName": "SOLIDAGO-Kassenpruefung-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SOLIDAGO Kassenprüfung",
      "deleteAppDataOnUninstall": false
    }
  }
}
